/**
 * Firebase Storage Security Rules
 * 
 * Copy these rules to Firebase Console → Storage → Rules
 */

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Company logos - readable by all, writable only by authenticated admins
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only upload via Firebase Console or Admin SDK
    }
  }
}
